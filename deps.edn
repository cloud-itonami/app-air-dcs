;; app-air-dcs — the air-dcs (airline departure control) appview.
;;
;; The Worker is ClojureScript, per the repo-wide runtime order in the
;; superproject AGENTS.md (kotoba wasm > clojurewasm > ClojureScript > nbb).
;; Keeping the entry in cljs rather than .kotoba is ADR-2606290000's standing
;; call: kotoba's ingress capability is :native-aot/:wasm-aot pending. The
;; decision-shaped parts live in .cljc so they are testable without a browser,
;; and are the first thing that moves to .kotoba when ingress qualifies.
;;
;; The design system is pinned to the tip of kotoba-lang/jp-go-digital-design-system
;; as measured 2026-08-18 (2e2d191, 2026-08-17T08:11:13Z). The shared west checkout
;; on this workstation carries 0a02180 (2026-08-12), five days behind it, so the
;; tests and the page render in docs/operator-quickstart.md are run against THIS
;; sha out of the ~/.gitlibs cache rather than against that checkout -- otherwise
;; the source under test and the source in the bundle would be two different
;; libraries.
;;
;; NOTE: `kotoba/` is NOT on this classpath and is not a dependency of anything
;; here. It is a TypeScript reference slice that no deployed code imports, and
;; this migration deliberately left it alone (README, "kotoba/ は移していない").
{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "ee440887baf7dfdfc41b84f0f07af31b05ee6b1a"
         :deps/root "lib/kotoba.text"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/kotoba.git"
         :git/sha "3dfb77e29a541416bfd6a39aee202ab770ddf952"
         :deps/root "lib/kotoba.jpGoDigitalDesignSystem"}}
 :aliases
 {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                      thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
